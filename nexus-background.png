@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap');
:root{--blue:#168cff;--cyan:#58c5ff;--white:#f4f8ff;--muted:#a9bad0;--glass:rgba(7,17,34,.78)}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;color:var(--white);font-family:Inter,Arial,sans-serif}body{background:#08182b url('assets/nexus-background.png') center center/cover no-repeat}.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,12,26,.75),rgba(4,14,30,.2) 58%,rgba(3,12,26,.62)),linear-gradient(0deg,rgba(2,9,20,.94),transparent 62%,rgba(2,9,20,.28));pointer-events:none}.topbar{position:absolute;top:4.2%;left:5%;right:5%;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:12px;font-weight:900;letter-spacing:2px;font-size:20px}.brand b{color:var(--cyan)}.brand small{display:block;color:#b6c9df;font-size:8px;letter-spacing:2.3px;margin-top:4px;font-weight:600}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid #55baff;background:rgba(13,104,190,.22);box-shadow:0 0 22px #168cff55;font-family:'Barlow Condensed';font-size:30px;font-style:italic}.server-pill{display:flex;align-items:center;gap:9px;border:1px solid #54baff55;background:#06172abf;padding:10px 15px;border-radius:3px;font-size:10px;font-weight:800;letter-spacing:1.5px}.server-pill i{width:7px;height:7px;background:#4bffac;border-radius:50%;box-shadow:0 0 10px #4bffac}
main{position:absolute;left:5%;top:20%;width:90%;display:flex;justify-content:space-between;align-items:flex-start;gap:3%}.welcome{max-width:44%;padding-top:1.8%}.eyebrow{font-size:11px;letter-spacing:3px;color:var(--cyan);font-weight:800}.welcome h1{font-family:'Barlow Condensed',Impact,sans-serif;font-size:clamp(42px,5.4vw,82px);line-height:.88;letter-spacing:1px;margin:16px 0;text-shadow:0 4px 22px #00152c}.welcome h1 span{color:#53baff}.sub{font-size:14px;color:#d5e4f4;letter-spacing:.3px}
.panels{width:47%;display:grid;grid-template-columns:1fr 1fr;gap:14px}.panel{background:linear-gradient(145deg,rgba(5,20,40,.88),rgba(7,25,48,.72));border:1px solid rgba(91,177,255,.32);box-shadow:0 12px 35px #00102077;backdrop-filter:blur(8px);padding:19px 18px;min-height:275px}.panel-heading{display:flex;align-items:center;gap:11px;padding-bottom:14px;border-bottom:1px solid #83caff2b}.icon{display:grid;place-items:center;width:33px;height:33px;background:#147ed533;border:1px solid #46b2ff88;color:#7bcaff;font-size:17px}.panel-heading small,.connection-row small{display:block;font-size:8px;letter-spacing:1.7px;color:#7dbce9;font-weight:800}.panel-heading h2{font-size:13px;letter-spacing:1px;margin:4px 0 0}.rules ul{list-style:none;margin:14px 0 0;padding:0}.rules li{margin:0 0 13px;padding-left:12px;border-left:2px solid #258fe5}.rules li b{display:block;font-size:11px;margin-bottom:3px}.rules li span{font-size:9px;line-height:1.45;color:#afc1d5}.news-feature{padding:17px 0 12px}.tag{font-size:8px;color:#70c7ff;letter-spacing:1.4px;font-weight:800}.news-feature h3{font-size:15px;margin:9px 0}.news-feature p,.tip p{font-size:10px;line-height:1.6;color:#afc1d5}.tip{border-top:1px solid #83caff2b;padding-top:11px}.tip span{font-size:8px;letter-spacing:1.5px;color:#70c7ff;font-weight:800}.tip p{margin:5px 0 0}
.loading-panel{position:absolute;left:5%;right:5%;bottom:5%;padding:18px 22px 14px;background:rgba(3,13,27,.88);border:1px solid #5abaff55;box-shadow:0 0 35px #00152d88;backdrop-filter:blur(10px)}.connection-row{display:grid;grid-template-columns:1fr 1fr 2fr;gap:18px;padding-bottom:15px}.connection-row strong{display:block;font-size:11px;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status strong{color:#77caff}.progress-meta{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:1.3px;color:#9eb6cf;font-weight:800;margin-bottom:8px}.progress-meta b{color:#fff;font-size:12px}.progress-track{height:5px;background:#263d56;position:relative;overflow:hidden}.progress-track>div:first-child{height:100%;width:0%;background:linear-gradient(90deg,#0878df,#5bcaff);box-shadow:0 0 14px #1a9cff;transition:width .25s}.progress-glow{position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.35),transparent);width:20%;animation:shine 2s linear infinite;pointer-events:none}@keyframes shine{from{transform:translateX(-100%)}to{transform:translateX(500%)}}.bottom-row{display:flex;justify-content:space-between;align-items:center;margin-top:11px;color:#91a9c2;font-size:9px}button{border:1px solid #49aef477;background:#0d4d7b66;color:#dff3ff;padding:8px 12px;font-size:9px;font-weight:800;letter-spacing:1px;cursor:pointer}button:hover{background:#1267a5}
@media(max-width:900px){main{top:15%;display:block}.welcome{max-width:100%;padding:0}.welcome h1{font-size:48px}.panels{width:100%;margin-top:20px}.panel{min-height:210px;padding:12px}.loading-panel{bottom:2%;left:3%;right:3%;padding:12px}.connection-row{gap:8px}.connection-row strong{font-size:9px}}
